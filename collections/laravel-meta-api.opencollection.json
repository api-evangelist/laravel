{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications Meta API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Meta",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/meta/organization"
          },
          "docs": "Get details about the currently authenticated organization."
        },
        {
          "info": {
            "name": "List regions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/meta/regions"
          },
          "docs": "List all available cloud regions."
        }
      ]
    }
  ],
  "bundled": true
}