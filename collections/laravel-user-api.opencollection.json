{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications User API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/user"
          },
          "docs": "Show the authenticated user.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Get user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/me"
          },
          "docs": "Show the authenticated user.\n\nProcessing mode: <small><code>sync</code></small>"
        }
      ]
    }
  ],
  "bundled": true
}