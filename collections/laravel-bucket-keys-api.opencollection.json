        {
          "info": {
            "name": "Update object storage key",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://cloud.laravel.com/api/bucket-keys/:filesystemKey",
            "params": [
              {
                "name": "filesystemKey",
                "value": "",
                "type": "path",
                "description": "The filesystem key identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an object storage key."
