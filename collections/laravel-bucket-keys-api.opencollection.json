                "type": "query"
              }
            ]
          },
          "docs": "Get a list of all keys for a specific object storage bucket."
        },
        {
          "info": {
            "name": "Create object storage key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.laravel.com/api/buckets/:filesystem/keys",
            "params": [
              {
                "name": "filesystem",
                "value": "",
                "type": "path",
                "description": "The filesystem identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new key for an object storage bucket."
        },
        {
          "info": {
            "name": "Get object storage key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/bucket-keys/:filesystemKey",
            "params": [
              {
                "name": "filesystemKey",
                "value": "",
                "type": "path",
                "description": "The filesystem key identifier"
              },
              {
                "name": "include",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get a specific object storage key."
