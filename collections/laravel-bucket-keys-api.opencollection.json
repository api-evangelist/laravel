{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications Bucket Keys API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Bucket Keys",
