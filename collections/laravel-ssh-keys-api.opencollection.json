{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications SSH Keys API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "SSH Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List server SSH keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/ssh-keys",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The number of results that will be returned per page."
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "The cursor to start the pagination from."
              },
              {
                "name": "filter[name]",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter[user]",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all SSH keys associated with the server.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Create server SSH key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/ssh-keys",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new SSH key to the server.\n\nProcessing mode: <small><code>async</code></small>"
        },
        {
          "info": {
            "name": "Get server SSH key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/ssh-keys/:key",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "key",
                "value": "",
                "type": "path",
                "description": "The key ID"
              }
            ]
          },
          "docs": "Get a specific SSH key associated with the server.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Delete server SSH key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/ssh-keys/:key",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "key",
                "value": "",
                "type": "path",
                "description": "The key ID"
              }
            ]
          },
          "docs": "Remove an SSH key from the server.\n\nProcessing mode: <small><code>async</code></small>"
        },
        {
          "info": {
            "name": "Get server public SSH key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/key",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              }
            ]
          },
          "docs": "Get the public SSH key for the server.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Update server public SSH key",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/key",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              }
            ]
          },
          "docs": "Regenerate the SSH key pair for the server and return the new public key.\n\nProcessing mode: <small><code>sync</code></small>"
        }
      ]
    }
  ],
  "bundled": true
}