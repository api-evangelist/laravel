{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications Commands API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Commands",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List commands",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/environments/:environment/commands",
            "params": [
              {
                "name": "environment",
                "value": "",
                "type": "path",
                "description": "The environment identifier"
              },
              {
                "name": "filter[status]",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter[command]",
                "value": "",
                "type": "query"
              },
              {
                "name": "include",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get a list of all commands for the given environment."
        },
        {
          "info": {
            "name": "Run command",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.laravel.com/api/environments/:environment/commands",
            "params": [
              {
                "name": "environment",
                "value": "",
                "type": "path",
                "description": "The environment identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Run a command on the given environment."
        },
        {
          "info": {
            "name": "Get command",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/commands/:command",
            "params": [
              {
                "name": "command",
                "value": "",
                "type": "path",
                "description": "The command identifier"
              },
              {
                "name": "include",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get the details of a specific command."
        },
        {
          "info": {
            "name": "List commands",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/sites/:site/commands",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "site",
                "value": "",
                "type": "path",
                "description": "The site ID"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The number of results that will be returned per page."
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "The cursor to start the pagination from."
              },
              {
                "name": "filter[user_id]",
                "value": "",
                "type": "query",
                "description": "The user ID of the command initiator."
              },
              {
                "name": "filter[status]",
                "value": "",
                "type": "query",
                "description": "The status of the command."
              },
              {
                "name": "filter[command]",
                "value": "",
                "type": "query",
                "description": "The command it ran."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all command runs for the site.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Create command",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/sites/:site/commands",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "site",
                "value": "",
                "type": "path",
                "description": "The site ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Run a command on the site.\n\nProcessing mode: <small><code>async</code></small>"
        },
        {
          "info": {
            "name": "Get command",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/sites/:site/commands/:command",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "site",
                "value": "",
                "type": "path",
                "description": "The site ID"
              },
              {
                "name": "command",
                "value": "",
                "type": "path",
                "description": "The command ID"
              }
            ]
          },
          "docs": "Get a specific command run.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Delete command",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/sites/:site/commands/:command",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "site",
                "value": "",
                "type": "path",
                "description": "The site ID"
              },
              {
                "name": "command",
                "value": "",
                "type": "path",
                "description": "The command ID"
              }
            ]
          },
          "docs": "Delete a command history.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Get command output",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/sites/:site/commands/:command/output",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "site",
                "value": "",
                "type": "path",
                "description": "The site ID"
              },
              {
                "name": "command",
                "value": "",
                "type": "path",
                "description": "The command ID"
              }
            ]
          },
          "docs": "Get the output of a specific command run.\n\nProcessing mode: <small><code>sync</code></small>"
        }
      ]
    }
  ],
  "bundled": true
}