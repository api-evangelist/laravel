{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications Server Credentials API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Server Credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List team server credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/teams/:team/server-credentials",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "team",
                "value": "",
                "type": "path",
                "description": "The team ID"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The number of results that will be returned per page."
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "The cursor to start the pagination from."
              }
            ]
          },
          "docs": "Show all server credentials for the team.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Create a new server credential share",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.laravel.com/api/orgs/:organization/teams/:team/server-credentials",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "team",
                "value": "",
                "type": "path",
                "description": "The team ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Share a server credential with a team.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Delete a server credential share",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cloud.laravel.com/api/orgs/:organization/teams/:team/server-credentials/:credential",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "team",
                "value": "",
                "type": "path",
                "description": "The team ID"
              },
              {
                "name": "credential",
                "value": "",
                "type": "path",
                "description": "The credential ID"
              }
            ]
          },
          "docs": "Unshare a server credential with a team.\n\nProcessing mode: <small><code>sync</code></small>"
        }
      ]
    }
  ],
  "bundled": true
}