{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications Recipes API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Recipes",
