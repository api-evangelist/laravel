{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications Firewall Rules API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Firewall Rules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List server firewall rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/firewall-rules",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The number of results that will be returned per page."
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "The cursor to start the pagination from."
              },
              {
                "name": "filter[name]",
                "value": "",
                "type": "query",
                "description": "The name of the firewall rule."
              },
              {
                "name": "filter[status]",
                "value": "",
                "type": "query",
                "description": "The status of the firewall rule."
              },
              {
                "name": "filter[ip_address]",
                "value": "",
                "type": "query",
                "description": "The IP address or subnet for the firewall rule."
              },
              {
                "name": "filter[type]",
                "value": "",
                "type": "query",
                "description": "The type of the firewall rule."
              },
              {
                "name": "filter[port]",
                "value": "",
                "type": "query",
                "description": "The port or port range for the firewall rule."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all firewall rules associated with the server.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Create server firewall rule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/firewall-rules",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new firewall rule to the server.\n\nProcessing mode: <small><code>async</code></small>"
        },
        {
          "info": {
            "name": "Get server firewall rule",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/firewall-rules/:rule",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "rule",
                "value": "",
                "type": "path",
                "description": "The rule ID"
              }
            ]
          },
          "docs": "Get a specific firewall rule associated with the server.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Delete server firewall rule",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/firewall-rules/:rule",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "rule",
                "value": "",
                "type": "path",
                "description": "The rule ID"
              }
            ]
          },
          "docs": "Remove a firewall rule from the server.\n\nProcessing mode: <small><code>async</code></small>"
        }
      ]
    }
  ],
  "bundled": true
}