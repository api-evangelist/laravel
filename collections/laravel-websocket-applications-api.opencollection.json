{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications WebSocket Applications API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "WebSocket Applications",
        "type": "folder"
      },
      "items": [
