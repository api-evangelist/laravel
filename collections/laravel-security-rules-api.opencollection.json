{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications Security Rules API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Security Rules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List site security rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/sites/:site/security-rules",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "site",
                "value": "",
                "type": "path",
                "description": "The site ID"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The number of results that will be returned per page."
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "The cursor to start the pagination from."
              },
              {
                "name": "filter[path]",
                "value": "",
                "type": "query",
                "description": "The path for the security rule."
              },
              {
                "name": "filter[status]",
                "value": "",
                "type": "query",
                "description": "The status of the security rule."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all security rules associated with the site.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Create site security rule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/sites/:site/security-rules",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "site",
                "value": "",
                "type": "path",
                "description": "The site ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new security rule to the site.\n\nProcessing mode: <small><code>async</code></small>"
        },
        {
          "info": {
            "name": "Get site security rule",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/sites/:site/security-rules/:securityRule",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "site",
                "value": "",
                "type": "path",
                "description": "The site ID"
              },
              {
                "name": "securityRule",
                "value": "",
                "type": "path",
                "description": "The security rule ID"
              }
            ]
          },
          "docs": "Get a specific security rule associated with the site.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Update site security rule",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/sites/:site/security-rules/:securityRule",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "site",
                "value": "",
                "type": "path",
                "description": "The site ID"
              },
              {
                "name": "securityRule",
                "value": "",
                "type": "path",
                "description": "The security rule ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing security rule for a site.\n\nProcessing mode: <small><code>async</code></small>"
        },
        {
          "info": {
            "name": "Delete site security rule",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/sites/:site/security-rules/:securityRule",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "site",
                "value": "",
                "type": "path",
                "description": "The site ID"
              },
              {
                "name": "securityRule",
                "value": "",
                "type": "path",
                "description": "The security rule ID"
              }
            ]
          },
          "docs": "Remove a security rule from the site.\n\nProcessing mode: <small><code>async</code></small>"
        }
      ]
    }
  ],
  "bundled": true
}