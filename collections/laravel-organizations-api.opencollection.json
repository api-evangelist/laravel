{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications Organizations API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List organizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs",
            "params": [
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The number of results that will be returned per page."
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "The cursor to start the pagination from."
              }
            ]
          },
          "docs": "Show all organizations the user has access to.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Get organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              }
            ]
          },
          "docs": "Show a specific organization for the user.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "List server credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/server-credentials",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The number of results that will be returned per page."
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "The cursor to start the pagination from."
              }
            ]
          },
          "docs": "Show all server credentials for the organization.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Get server credential",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/server-credentials/:credential",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "credential",
                "value": "",
                "type": "path",
                "description": "The credential ID"
              }
            ]
          },
          "docs": "Show a specific server credential for the organization.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "List VPCs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/server-credentials/:credential/regions/:region/vpcs",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "credential",
                "value": "",
                "type": "path",
                "description": "The credential ID"
              },
              {
                "name": "region",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List VPCs for the provider.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Create a new VPC",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.laravel.com/api/orgs/:organization/server-credentials/:credential/regions/:region/vpcs",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "credential",
                "value": "",
                "type": "path",
                "description": "The credential ID"
              },
              {
                "name": "region",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a private network for the provider.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Get VPC",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/server-credentials/:credential/regions/:region/vpcs/:vpcId",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "credential",
                "value": "",
                "type": "path",
                "description": "The credential ID"
              },
              {
                "name": "region",
                "value": "",
                "type": "path"
              },
              {
                "name": "vpcId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a VPC for the provider.\n\nProcessing mode: <small><code>sync</code></small>"
        }
      ]
    }
  ],
  "bundled": true
}