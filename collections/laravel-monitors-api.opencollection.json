{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications Monitors API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Monitors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List server monitors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/monitors",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The number of results that will be returned per page."
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "The cursor to start the pagination from."
              },
              {
                "name": "filter[status]",
                "value": "",
                "type": "query",
                "description": "The status of the monitor."
              },
              {
                "name": "filter[state]",
                "value": "",
                "type": "query",
                "description": "The state of the monitor."
              },
              {
                "name": "filter[type]",
                "value": "",
                "type": "query",
                "description": "The type of the monitor."
              },
              {
                "name": "filter[notify]",
                "value": "",
                "type": "query",
                "description": "The email address to notify when the monitor is in an alert state."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all monitors associated with the server.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Create server monitor",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/monitors",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new monitor to the server.\n\nProcessing mode: <small><code>async</code></small>"
        },
        {
          "info": {
            "name": "Get server monitor",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/monitors/:monitor",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "monitor",
                "value": "",
                "type": "path",
                "description": "The monitor ID"
              }
            ]
          },
          "docs": "Get a specific monitor associated with the server.\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Delete server monitor",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/monitors/:monitor",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "monitor",
                "value": "",
                "type": "path",
                "description": "The monitor ID"
              }
            ]
          },
          "docs": "Remove a monitor from the server.\n\nProcessing mode: <small><code>async</code></small>"
        }
      ]
    }
  ],
  "bundled": true
}