{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laravel Cloud Applications Logs API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get server log content",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/logs/:key",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "key",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "\n\nProcessing mode: <small><code>sync</code></small>"
        },
        {
          "info": {
            "name": "Delete server log content",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cloud.laravel.com/api/orgs/:organization/servers/:server/logs/:key",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The organization slug"
              },
              {
                "name": "server",
                "value": "",
                "type": "path",
                "description": "The server ID"
              },
              {
                "name": "key",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "\n\nProcessing mode: <small><code>async</code></small>"
        }
      ]
    }
  ],
  "bundled": true
}